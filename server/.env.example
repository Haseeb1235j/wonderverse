# Server only. Never place keys in a VITE_ variable or commit this file with real values.
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_API_KEY=
SEARCH_PROVIDER_ORDER=tavily,serper,brave
# All disabled until you set conservative caps based on credits actually remaining.
# These are lifetime attempt caps against the persistent ledger, not monthly quotas.
TAVILY_REQUEST_LIMIT=0
SERPER_REQUEST_LIMIT=0
BRAVE_REQUEST_LIMIT=0
SEARCH_DAILY_LIMIT=30
SEARCH_USAGE_FILE=server/data/usage.json
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SEARCH_HOST=127.0.0.1
SEARCH_PORT=8787
